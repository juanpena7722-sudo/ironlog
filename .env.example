# Production stack (docker-compose.prod.yml). Copy to `.env` next to the compose file and fill in.
# Database password. Use URL-safe characters only (it is placed in DATABASE_URL),
# e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# At least 32 characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Caddy site address: a domain name (automatic HTTPS) or `:80` for plain HTTP.
SITE_ADDRESS=:80
